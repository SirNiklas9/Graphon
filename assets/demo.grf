# Graphon demo scene — everything defined in .grf
type: scene
camera: -15,10,20 target:0,2,0
ambient: 0.06,0.06,0.1

# Lighting
light: directional 10,15,5 target:-1,0,-0.5 color:0.9,0.75,0.5
light: point 8,3,0 color:1.2,0.8,0.3
light: point -6,4,-6 color:0.2,0.3,0.8
light: point 8,3,8 color:0.15,0.6,0.2

# Atmosphere
volume: -30,-1,-30 -10,10,30 color:0.05,0.08,0.2 density:0.3
fog: color:0.05,0.05,0.08 start:30 end:80

# Ground (centered at origin, 40x40)
include: ground.grf at -20,-1,-20 scale:1

# Red cube (center stage)
include: red_cube.grf at -1,0,-1 scale:1

# Pillars (spread out, symmetrical)
include: pillar_green.grf at -12,0,-8 scale:1
include: pillar_blue.grf at 12,0,-8 scale:1
include: pillar_pink.grf at -12,0,8 scale:1
include: pillar_cyan.grf at 12,0,8 scale:1

# Models (spaced apart from primitives)
include: suzanne_obj.grf at -8,2,0 scale:2
include: bunny_obj.grf at 8,0,0 scale:5

# Billboard (floating, visible from spawn)
include: billboard_test.grf at 0,5,-8 scale:1

# Voxel house (off to the side)
include: voxel_house.grf at -15,0,10 scale:1
